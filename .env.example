# Copy to .env; never commit .env
LIBRARYMATE_MODE=demo
# For a real tool-calling LLM: LIBRARYMATE_MODE=gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# Local multilingual semantic RAG; downloaded once on first index build
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Guardrails (fixed budgets in src/agent/graph.py): 3 LLM calls / 5 total tools / 3 tools per response
